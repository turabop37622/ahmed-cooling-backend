# Server Configuration
PORT=5000
NODE_ENV=development

# Database - MongoDB Atlas
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/ahmed-cooling?retryWrites=true&w=majority

# JWT
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_64_CHARS
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
# First boot only: creates the admin when the database has no admin at all (password 16-72 chars).
# Remove both ADMIN_SEED_* variables after the first successful boot.
ADMIN_SEED_EMAIL=your-admin@email.com
ADMIN_SEED_PASSWORD=CHANGE_ME_TO_A_UNIQUE_ADMIN_PASSWORD
BREVO_API_KEY=YOUR_BREVO_API_KEY

# Email Configuration (Brevo)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=YOUR_BREVO_SMTP_USER
EMAIL_PASS=YOUR_BREVO_SMTP_PASSWORD

ADMIN_EMAIL=your-admin@email.com
EMAIL_FROM=verified-sender@your-domain.com
BACKEND_URL=http://localhost:5000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Geocode
GOOGLE_GEOCODE_KEY=your_google_geocode_api_key

# Number of reverse proxies in front of the API (Render = 1). Needed so rate limits work per visitor.
# Default when unset: 1 in production (NODE_ENV=production or on Render), off locally.
TRUST_PROXY=1
# Comma-separated browser origins allowed by CORS (replaces the built-in production list when set).
# localhost origins are added automatically outside production and always refused in production.
CORS_ORIGINS=https://ahmedcoolingworkshop.com,https://www.ahmedcoolingworkshop.com,https://ahmed-cooling-web.vercel.app
# Fixed visit fee added to every booking (same number in each customer's currency)
VISIT_CHARGE=30
# Support phone number shown in customer emails (leave empty to hide it), e.g. +966 5X XXX XXXX
SUPPORT_PHONE=

# Push notifications through Firebase Cloud Messaging (technician + customer app FCM tokens).
# The Firebase service-account key JSON (Firebase console > Project settings > Service accounts > Generate new private key),
# pasted either as the raw JSON on one line or base64-encoded. Leave empty to skip FCM (Expo push tokens still work).
FIREBASE_SERVICE_ACCOUNT=

# WhatsApp booking-confirmation bot (Meta WhatsApp Cloud API — utils/whatsappBookingBot.js).
# Leave these empty and the bot simply stays off (no scheduler, every send logs to the console instead).
# Meta for Developers > your App > WhatsApp > API Setup: "Temporary access token" (swap for a permanent
# System User token before going live) and "Phone number ID".
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version the calls are made against.
WHATSAPP_API_VERSION=v21.0
# Any string you choose — paste the SAME value into Meta's webhook "Verify token" field when you set the
# Callback URL to https://<your-backend>/api/whatsapp/webhook.
WHATSAPP_VERIFY_TOKEN=
# Meta signs every webhook with the app secret; when set, requests without a valid signature are rejected (401).
# Meta for Developers > your App > App settings > Basic > App secret. Strongly recommended — without it anyone who
# knows the webhook URL can post fake customer messages.
WHATSAPP_APP_SECRET=
# Name + language of the approved message template used for the very first "please confirm" message (Meta
# requires an approved template for a business-initiated message outside the customer's 24h window). Create it
# in Meta Business Manager > WhatsApp Manager > Message Templates with a body + two quick-reply buttons.
WHATSAPP_CONFIRM_TEMPLATE_NAME=booking_confirmation
WHATSAPP_CONFIRM_TEMPLATE_LANG=ar
# Must exactly match the payload/id you set on the template's two quick-reply buttons.
WHATSAPP_CONFIRM_PAYLOAD=BOOKING_CONFIRM
WHATSAPP_CANCEL_PAYLOAD=BOOKING_CANCEL
# Seconds after a booking is created before the bot sends the confirmation request (default 5).
WHATSAPP_BOOKING_CONFIRM_DELAY_SEC=5

# General WhatsApp FAQ bot (utils/whatsappChatbot.js) — answers free-form customer questions about services,
# pricing and areas served, and hands off to an admin (via the admin panel's WhatsApp Inbox) when a customer
# asks for a human or the model isn't confident answering. Leave empty and the bot stays silent on anything
# that isn't the booking-confirmation flow above (the admin can still see and reply to every message in the
# inbox). Free API key from console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Technician dispatch WhatsApp messages (utils/dispatchWhatsApp.js). Optional: approved Utility templates with body variables
# TECH_OFFER: {{1}} service {{2}} when {{3}} area; CUSTOMER_ASSIGNED: {{1}} customer {{2}} order no. {{3}} technician {{4}} technician phone.
# Leave a name empty to send plain text instead (delivered only inside the customer/technician 24h window).
WHATSAPP_TECH_OFFER_TEMPLATE=
WHATSAPP_CUSTOMER_ASSIGNED_TEMPLATE=
# 1 if that template has an IMAGE header: the technician's photo (admin > Wallets & Jobs > technician) is sent in it,
# or WHATSAPP_DEFAULT_TECH_IMAGE (default: the site logo) when the technician has no photo yet.
WHATSAPP_CUSTOMER_ASSIGNED_IMAGE=
WHATSAPP_DEFAULT_TECH_IMAGE=
WHATSAPP_DISPATCH_TEMPLATE_LANG=en_US
