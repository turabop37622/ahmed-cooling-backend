# Server Configuration
PORT=5000
NODE_ENV=development

# Database - MongoDB Atlas
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/ahmed-cooling?retryWrites=true&w=majority

# JWT
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_64_CHARS
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
# First boot only: creates the admin when the database has no admin at all (password 16-72 chars).
# Remove both ADMIN_SEED_* variables after the first successful boot.
ADMIN_SEED_EMAIL=your-admin@email.com
ADMIN_SEED_PASSWORD=CHANGE_ME_TO_A_UNIQUE_ADMIN_PASSWORD
BREVO_API_KEY=YOUR_BREVO_API_KEY

# Email Configuration (Brevo)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=YOUR_BREVO_SMTP_USER
EMAIL_PASS=YOUR_BREVO_SMTP_PASSWORD

ADMIN_EMAIL=your-admin@email.com
EMAIL_FROM=verified-sender@your-domain.com
BACKEND_URL=http://localhost:5000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Geocode
GOOGLE_GEOCODE_KEY=your_google_geocode_api_key

# Number of reverse proxies in front of the API (Render = 1). Needed so rate limits work per visitor.
# Default when unset: 1 in production (NODE_ENV=production or on Render), off locally.
TRUST_PROXY=1
# Comma-separated browser origins allowed by CORS (replaces the built-in production list when set).
# localhost origins are added automatically outside production and always refused in production.
CORS_ORIGINS=https://ahmedcoolingworkshop.com,https://www.ahmedcoolingworkshop.com,https://ahmed-cooling-web.vercel.app
# Fixed visit fee added to every booking (same number in each customer's currency)
VISIT_CHARGE=30
# Support phone number shown in customer emails (leave empty to hide it), e.g. +966 5X XXX XXXX
SUPPORT_PHONE=
